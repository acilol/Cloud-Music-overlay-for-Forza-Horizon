<Window x:Class="HorizonRadioOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HorizonRadioOverlay"
        Title="[直播源] 网易云悬浮窗 v3.1.1"
        Width="210"
        Height="198"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="False"
        FontFamily="pack://application:,,,/HorizonRadioOverlay;component/Assets/Fonts/#MiSans Demibold">
    <Window.Resources>
        <DropShadowEffect x:Key="TextGlow" Color="#05080B" BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="1" />
        <DropShadowEffect x:Key="CoverShadow" Color="#091019" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.42" />
    </Window.Resources>

    <Viewbox Stretch="Fill">
        <Grid Name="OverlayRoot" Width="210" Height="198" Background="Transparent" Margin="0" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RootTransform" Y="8" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition x:Name="CoverRow" Height="100" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Viewport3D Name="CoverFlowViewport"
                        Grid.Row="0"
                        Width="760"
                        Height="286"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        ClipToBounds="False"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0,0,1050"
                                       LookDirection="0,0,-1050"
                                       UpDirection="0,1,0"
                                       FieldOfView="32.8" />
                </Viewport3D.Camera>
            </Viewport3D>

            <Border Name="CoverFrame"
                    Width="96"
                    Height="96"
                    CornerRadius="12"
                    ClipToBounds="True"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,4"
                    Effect="{StaticResource CoverShadow}">
                <Image Name="CoverImage" Stretch="UniformToFill">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,96,96" RadiusX="12" RadiusY="12" />
                    </Image.Clip>
                </Image>
            </Border>

            <Grid Name="InfoPanel"
                  Grid.Row="1"
                  Width="188"
                  Height="70"
                  Margin="0"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Viewbox x:Name="TitleContainer" Grid.Row="0" Width="188" Height="28" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Name="TitleText"
                               FontSize="19"
                               FontWeight="SemiBold"
                               FontStretch="Normal"
                               TextWrapping="NoWrap"
                               TextTrimming="None"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Effect="{StaticResource TextGlow}" />
                </Viewbox>

                <Viewbox x:Name="ArtistContainer" Grid.Row="1" Width="188" Height="23" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Name="ArtistText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontStretch="Normal"
                               TextWrapping="NoWrap"
                               TextTrimming="None"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Effect="{StaticResource TextGlow}" />
                </Viewbox>

                <Viewbox Grid.Row="2" Width="188" Height="18" Stretch="Uniform" StretchDirection="DownOnly" Visibility="Collapsed" Name="LyricsContainer">
                    <TextBlock Name="LyricsText"
                               FontSize="11"
                               FontStretch="Expanded"
                               TextWrapping="NoWrap"
                               TextTrimming="None"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="#A0B8D0"
                               Effect="{StaticResource TextGlow}" />
                </Viewbox>
            </Grid>

            <Border Name="DragOverlayBorder"
                    Grid.RowSpan="2"
                    BorderThickness="2"
                    BorderBrush="#3B82F6"
                    CornerRadius="8"
                    Background="#331E293B"
                    Visibility="Collapsed"
                    Cursor="SizeAll">
                <Grid>
                    <TextBlock Name="DragCoordinateText"
                               Text="X: 0%  Y: 59%"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#60A5FA"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,4,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{x:Static local:UiText.DragTip}"
                               FontSize="9.5"
                               Foreground="#E2E8F0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="4,0,4,4">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>
