<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#D7FF3F" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFFFAD" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#20232C" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#586C13" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F6F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#EFF1F5" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8EBF1" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EB" />
    <SolidColorBrush x:Key="TextBrush" Color="#20232C" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#727988" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#A1A7B3" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B94F64" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#287D70" />
    <SolidColorBrush x:Key="WarningBrush" Color="#977044" />
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="IconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
