<UserControl x:Class="HorizonRadioOverlay.Views.Pages.HotkeySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,12,36,30" MaxWidth="1080">
            <TextBlock Text="键盘映射" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,22" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="操作" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="1" Text="应用快捷键" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="3" Text="网易云快捷键" Style="{StaticResource CaptionTextStyle}" />
            </Grid>
            <Border Style="{StaticResource SettingRowStyle}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="上一首" VerticalAlignment="Center" FontSize="13" />
    <TextBox x:Name="AppPrevHotkeyBox" Grid.Column="1" FontFamily="Consolas" ToolTip="按下要使用的快捷键" Text="{Binding AppPrevHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBox x:Name="NeteasePrevHotkeyBox" Grid.Column="3" FontFamily="Consolas" Text="{Binding NeteasePrevHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="与网易云中的快捷键保持一致" />
</Grid></Border>
<Border Style="{StaticResource SettingRowStyle}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="下一首" VerticalAlignment="Center" FontSize="13" />
    <TextBox x:Name="AppNextHotkeyBox" Grid.Column="1" FontFamily="Consolas" ToolTip="按下要使用的快捷键" Text="{Binding AppNextHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBox x:Name="NeteaseNextHotkeyBox" Grid.Column="3" FontFamily="Consolas" Text="{Binding NeteaseNextHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="与网易云中的快捷键保持一致" />
</Grid></Border>
<Border Style="{StaticResource SettingRowStyle}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="播放 / 暂停" VerticalAlignment="Center" FontSize="13" />
    <TextBox x:Name="AppToggleHotkeyBox" Grid.Column="1" FontFamily="Consolas" ToolTip="按下要使用的快捷键" Text="{Binding AppToggleHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBox x:Name="NeteaseToggleHotkeyBox" Grid.Column="3" FontFamily="Consolas" Text="{Binding NeteaseToggleHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="与网易云中的快捷键保持一致" />
</Grid></Border>
<Border Style="{StaticResource SettingRowStyle}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="显示 / 隐藏浮窗" VerticalAlignment="Center" FontSize="13" />
    <TextBox x:Name="AppToggleOverlayHotkeyBox" Grid.Column="1" FontFamily="Consolas" ToolTip="按下要使用的快捷键" Text="{Binding AppToggleOverlayHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Column="3" Text="Horizon" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="12" />
</Grid></Border>
            <Grid Margin="0,34,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <TextBlock Text="手柄与方向盘" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                <CheckBox x:Name="EnableGamepadCheckBox" Grid.Column="1" Content="启用" IsChecked="{Binding EnableGamepadHotkeys, Mode=TwoWay}" />
            </Grid>
            <StackPanel IsEnabled="{Binding EnableGamepadHotkeys}">
                <Border Style="{StaticResource SettingRowStyle}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="上一首" VerticalAlignment="Center" FontSize="13" />
    <TextBox x:Name="GamepadPrevHotkeyBox" Grid.Column="1" FontFamily="Consolas" Text="{Binding GamepadPrevHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="按下手柄或方向盘上的组合键" />
</Grid></Border>
<Border Style="{StaticResource SettingRowStyle}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="下一首" VerticalAlignment="Center" FontSize="13" />
    <TextBox x:Name="GamepadNextHotkeyBox" Grid.Column="1" FontFamily="Consolas" Text="{Binding GamepadNextHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="按下手柄或方向盘上的组合键" />
</Grid></Border>
<Border Style="{StaticResource SettingRowStyle}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="播放 / 暂停" VerticalAlignment="Center" FontSize="13" />
    <TextBox x:Name="GamepadToggleHotkeyBox" Grid.Column="1" FontFamily="Consolas" Text="{Binding GamepadToggleHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="按下手柄或方向盘上的组合键" />
</Grid></Border>
<Border Style="{StaticResource SettingRowStyle}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="显示 / 隐藏浮窗" VerticalAlignment="Center" FontSize="13" />
    <TextBox x:Name="GamepadToggleOverlayHotkeyBox" Grid.Column="1" FontFamily="Consolas" Text="{Binding GamepadToggleOverlayHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="按下手柄或方向盘上的组合键" />
</Grid></Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
