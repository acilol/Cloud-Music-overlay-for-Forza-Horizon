<UserControl x:Class="HorizonRadioOverlay.Views.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="36,12,36,30" MaxWidth="1080">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="运行记录" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OpenLogFileButton" Style="{StaticResource IconButtonStyle}" Command="{Binding OpenLogFileCommand}" ToolTip="打开日志文件" Margin="0,0,8,0"><TextBlock Text="&#xE8E5;" Style="{StaticResource IconTextStyle}" /></Button>
                <Button x:Name="CopyLogButton" Style="{StaticResource IconButtonStyle}" Command="{Binding CopyLogCommand}" ToolTip="复制日志" Margin="0,0,8,0"><TextBlock Text="&#xE8C8;" Style="{StaticResource IconTextStyle}" /></Button>
                <Button x:Name="ClearLogButton" Style="{StaticResource IconButtonStyle}" Foreground="{DynamicResource DangerBrush}" Command="{Binding ClearLogCommand}" ToolTip="清空日志"><TextBlock Text="&#xE74D;" Style="{StaticResource IconTextStyle}" /></Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource MutedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="LogTextBlock" Text="{Binding LogText}" FontFamily="Consolas" FontSize="12" LineHeight="20" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
