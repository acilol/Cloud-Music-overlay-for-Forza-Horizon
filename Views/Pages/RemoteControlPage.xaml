<UserControl x:Class="HorizonRadioOverlay.Views.Pages.RemoteControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,12,36,30" MaxWidth="1080">
            <Border Style="{StaticResource SettingRowStyle}">
                <CheckBox x:Name="EnableRemoteControlCheckBox" Content="手机遥控" IsChecked="{Binding EnableRemoteControl, Mode=TwoWay}" FontSize="15" FontWeight="SemiBold" />
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                    <TextBlock Text="服务端口" VerticalAlignment="Center" />
                    <TextBox x:Name="RemoteControlPortBox" Grid.Column="1" FontFamily="Consolas" Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRowStyle}">
                <CheckBox x:Name="RemoteControlAllowLanCheckBox" Content="允许局域网访问" IsChecked="{Binding AllowLan, Mode=TwoWay}" />
            </Border>
            <Grid Margin="0,34,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="204" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="连接" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="RemoteControlStatusText" Text="{Binding StatusText}" Margin="0,12,0,0" Foreground="{DynamicResource AccentInkBrush}" FontSize="13" />
                    <TextBlock Text="访问地址" Style="{StaticResource CaptionTextStyle}" Margin="0,28,0,9" />
                    <TextBox x:Name="RemoteControlAddressBox" Text="{Binding Address, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" FontFamily="Consolas" FontSize="12" />
                    <TextBlock x:Name="RemoteControlHelpText" Text="{Binding HelpText}" Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0" />
                    <WrapPanel Margin="0,20,0,0">
                        <Button x:Name="CopyRemoteAddressButton" Command="{Binding CopyAddressCommand}" ToolTip="复制连接地址" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconTextStyle}" />
                        </Button>
                        <Button x:Name="ResetRemoteTokenButton" Command="{Binding ResetTokenCommand}" ToolTip="重置连接令牌" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}" />
                        </Button>
                        <Button x:Name="ConfigureFirewallButton" Command="{Binding ConfigureFirewallCommand}" ToolTip="允许手机连接" Style="{StaticResource GhostButtonStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE83D;" Style="{StaticResource IconTextStyle}" Margin="0,0,8,0" /><TextBlock Text="防火墙" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Width="204" Height="204" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="12">
                        <Grid>
                            <TextBlock Text="未连接" FontSize="13" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Image x:Name="RemoteControlQrImage" Source="{Binding QrCodeImage}" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <TextBlock Text="手机连接" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
