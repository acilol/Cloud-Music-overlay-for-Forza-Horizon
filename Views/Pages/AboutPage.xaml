<UserControl x:Class="HorizonRadioOverlay.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,30" MaxWidth="1080">
            <Border Width="54" Height="54" CornerRadius="8" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left">
                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="HORIZON" FontFamily="Bahnschrift" FontSize="40" Margin="0,24,0,0" />
            <TextBlock Text="音乐浮窗" FontSize="16" Margin="0,8,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
            <TextBlock x:Name="VersionText" Text="{Binding VersionText}" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,0" />
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,36,0,0" Padding="0,26,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="项目" Style="{StaticResource CaptionTextStyle}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="acilol / Cloud-Music-overlay-for-Forza-Horizon" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="基于 xw66 的开源项目" Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <WrapPanel Margin="0,32,0,0">
                <Button x:Name="ProjectHomeButton" Command="{Binding OpenProjectHomeCommand}" Margin="0,0,10,10">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource IconTextStyle}" Margin="0,0,8,0" /><TextBlock Text="项目仓库" /></StackPanel>
                </Button>
                <Button x:Name="CheckUpdateButton" Command="{Binding CheckUpdateCommand}" Margin="0,0,10,10">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource IconTextStyle}" Margin="0,0,8,0" /><TextBlock Text="检查上游更新" /></StackPanel>
                </Button>
                <Button x:Name="LicenseButton" Command="{Binding OpenLicenseCommand}" Style="{StaticResource GhostButtonStyle}" Content="开源协议" Margin="0,0,0,10" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
