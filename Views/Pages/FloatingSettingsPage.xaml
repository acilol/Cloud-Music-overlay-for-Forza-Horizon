<UserControl x:Class="HorizonRadioOverlay.Views.Pages.FloatingSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent"
             SizeChanged="FloatingSettingsPage_SizeChanged">
    <UserControl.Resources>
        <DrawingBrush x:Key="MonitorGridBrush" Viewport="0,0,24,24" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#EEF0F4" Geometry="M0,0 L24,0 24,24 0,24 Z" />
                <GeometryDrawing Geometry="M0,24 L0,0 24,0"><GeometryDrawing.Pen><Pen Brush="#DCE1E9" Thickness="0.7" /></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageLayout" Margin="36,12,36,30" MaxWidth="1080">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="0" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="PositionSection">
                <TextBlock Text="位置与大小" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,20" />
                <Border x:Name="PositionPreviewSurface" Background="{StaticResource MonitorGridBrush}" BorderBrush="#CFD6E1" BorderThickness="1" CornerRadius="20" Height="232" ClipToBounds="True">
                    <Grid>
                        <Canvas x:Name="PreviewCanvas" Margin="12" SizeChanged="PreviewCanvas_SizeChanged">
                            <Grid x:Name="PreviewOverlay" Width="104" Height="136" IsHitTestVisible="False" RenderTransformOrigin="0,0">
                                <Grid.RenderTransform><ScaleTransform x:Name="PreviewScaleTransform" /></Grid.RenderTransform>
                                <Image Width="82" Height="82" VerticalAlignment="Top" Source="/HorizonRadioOverlay;component/Assets/Artwork/preview-forest.jpg" Stretch="UniformToFill">
                                    <Image.Clip><RectangleGeometry Rect="0,0,82,82" RadiusX="5" RadiusY="5" /></Image.Clip>
                                </Image>
                                <StackPanel Margin="0,87,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="林间" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="Horizon" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Canvas>
                        <TextBlock Text="DISPLAY PREVIEW" FontSize="11" FontFamily="Bahnschrift" Margin="12"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="#7E9587" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <TextBlock Text="显示器" Style="{StaticResource CaptionTextStyle}" Margin="0,22,0,8" />
                <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
    <TextBlock Text="水平位置" FontSize="13" VerticalAlignment="Center" />
    <Slider x:Name="HorizontalSlider" x:FieldModifier="public" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding HorizontalPercent, Mode=TwoWay}" ValueChanged="PreviewSlider_ValueChanged" />
    <TextBlock x:Name="HorizontalValueText" x:FieldModifier="public" Grid.Column="2" Text="{Binding HorizontalText}" FontSize="13" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
</Grid>
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
    <TextBlock Text="垂直位置" FontSize="13" VerticalAlignment="Center" />
    <Slider x:Name="BottomOffsetSlider" x:FieldModifier="public" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BottomOffsetPercent, Mode=TwoWay}" ValueChanged="PreviewSlider_ValueChanged" />
    <TextBlock x:Name="BottomOffsetValueText" x:FieldModifier="public" Grid.Column="2" Text="{Binding BottomOffsetText}" FontSize="13" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
</Grid>
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
    <TextBlock Text="缩放" FontSize="13" VerticalAlignment="Center" />
    <Slider x:Name="ScaleSlider" x:FieldModifier="public" Grid.Column="1" Minimum="80" Maximum="180" Value="{Binding ScalePercent, Mode=TwoWay}" ValueChanged="PreviewSlider_ValueChanged" />
    <TextBlock x:Name="ScaleValueText" x:FieldModifier="public" Grid.Column="2" Text="{Binding ScaleText}" FontSize="13" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
</Grid>
                <Button Content="{Binding AdjustPositionButtonText}" Command="{Binding ToggleDragRepositionCommand}" Margin="0,22,0,0" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel x:Name="BehaviorSection" Grid.Column="2">
                <TextBlock Text="播放器" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,20" />
                <ComboBox x:Name="TrackSourceComboBox" x:FieldModifier="public" ItemsSource="{Binding TrackSources}" DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedTrackSource, Mode=TwoWay}">
                    <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" /><Setter Property="ToolTip" Value="{Binding ToolTip}" />
                    </Style></ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Text="浮窗行为" Style="{StaticResource SectionTitleTextStyle}" Margin="0,30,0,4" />
                <Border Style="{StaticResource SettingRowStyle}"><CheckBox x:Name="EnableLyricsCheckBox" x:FieldModifier="public" Content="显示歌词" IsChecked="{Binding EnableLyrics, Mode=TwoWay}" IsEnabled="{Binding IsLyricsOptionEnabled}" ToolTip="{Binding LyricsOptionToolTip}" /></Border>
                <Border Style="{StaticResource SettingRowStyle}"><CheckBox x:Name="EnableNeteaseMemoryTimelineCheckBox" x:FieldModifier="public" Content="网易云时间轴" IsChecked="{Binding EnableNeteaseMemoryTimeline, Mode=TwoWay}" IsEnabled="{Binding IsNeteaseTimelineEnabled}" ToolTip="{Binding NeteaseTimelineToolTip}" /></Border>
                <Border Style="{StaticResource SettingRowStyle}"><CheckBox x:Name="AlwaysShowCheckBox" x:FieldModifier="public" Content="始终显示" IsChecked="{Binding AlwaysShowOverlay, Mode=TwoWay}"  /></Border>
                <Border Style="{StaticResource SettingRowStyle}"><CheckBox x:Name="HideOverlayWhenPausedCheckBox" x:FieldModifier="public" Content="暂停时隐藏" IsChecked="{Binding HideOverlayWhenPaused, Mode=TwoWay}"  /></Border>
                <Border Style="{StaticResource SettingRowStyle}"><CheckBox x:Name="EnableCoverWingEffectCheckBox" x:FieldModifier="public" Content="Cover Flow" IsChecked="{Binding EnableCoverWingEffect, Mode=TwoWay}"  /></Border>
                <TextBlock Text="应用" Style="{StaticResource SectionTitleTextStyle}" Margin="0,28,0,4" />
                <Border Style="{StaticResource SettingRowStyle}"><CheckBox x:Name="MinimizeToTrayCheckBox" x:FieldModifier="public" Content="关闭时留在托盘" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"  /></Border>
                <Border Style="{StaticResource SettingRowStyle}"><CheckBox x:Name="AutoStartCheckBox" x:FieldModifier="public" Content="开机启动" IsChecked="{Binding AutoStartOnBoot, Mode=TwoWay}"  /></Border>
                <Border Style="{StaticResource SettingRowStyle}"><CheckBox x:Name="DiagnosticCheckBox" x:FieldModifier="public" Content="诊断日志" IsChecked="{Binding DiagnosticMode, Mode=TwoWay}"  /></Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
