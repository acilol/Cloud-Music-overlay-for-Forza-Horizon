<UserControl x:Class="HorizonRadioOverlay.Views.Pages.ThemeSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HorizonRadioOverlay.Views" Background="Transparent"
             SizeChanged="ThemeSettingsPage_SizeChanged">
    <UserControl.Resources><DropShadowEffect x:Key="OverlayTextShadow" Color="#05080B" BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="1" /></UserControl.Resources>
        <Grid x:Name="PageLayout" Margin="36,12,36,30" MaxWidth="1080">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer x:Name="AppearanceEditor" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="界面强调色" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="ThemeAccentGreenButton" x:FieldModifier="public" GroupName="Accent" Background="#D7FF3F" Style="{StaticResource ColorSwatchRadioStyle}" ToolTip="电光" />
                            <RadioButton x:Name="ThemeAccentBlueButton" x:FieldModifier="public" GroupName="Accent" Background="#326BEE" Style="{StaticResource ColorSwatchRadioStyle}" ToolTip="钴蓝" />
                            <RadioButton x:Name="ThemeAccentRoseButton" x:FieldModifier="public" GroupName="Accent" Background="#AD526A" Style="{StaticResource ColorSwatchRadioStyle}" ToolTip="玫瑰" />
                            <RadioButton x:Name="ThemeAccentIndigoButton" x:FieldModifier="public" GroupName="Accent" Background="#635E89" Style="{StaticResource ColorSwatchRadioStyle}" ToolTip="鸢尾" />
                            <RadioButton x:Name="ThemeAccentAmberButton" x:FieldModifier="public" GroupName="Accent" Background="#53625B" Style="{StaticResource ColorSwatchRadioStyle}" ToolTip="石墨" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="歌名" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding SetActiveTargetCommand}" CommandParameter="Title" Padding="9,4" MinHeight="30" ToolTip="编辑歌名颜色">
            <StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="7" Background="{Binding TitleBrush}" BorderBrush="#BDC9C1" BorderThickness="1" Margin="0,0,8,0" /><TextBlock Text="{Binding TitleColor}" FontFamily="Consolas" FontSize="12" /></StackPanel>
        </Button>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,14,0,10">
        <RadioButton x:Name="TitleColor_White" x:FieldModifier="public" GroupName="TitleColor" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="#FFFFFF" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectTitleColorCommand}" CommandParameter="#FFFFFF" />
<RadioButton x:Name="TitleColor_Light" x:FieldModifier="public" GroupName="TitleColor" Background="#D0E0F0" Tag="#D0E0F0" ToolTip="#D0E0F0" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectTitleColorCommand}" CommandParameter="#D0E0F0" />
<RadioButton x:Name="TitleColor_Yellow" x:FieldModifier="public" GroupName="TitleColor" Background="#F0E080" Tag="#F0E080" ToolTip="#F0E080" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectTitleColorCommand}" CommandParameter="#F0E080" />
<RadioButton x:Name="TitleColor_Green" x:FieldModifier="public" GroupName="TitleColor" Background="#90EE90" Tag="#90EE90" ToolTip="#90EE90" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectTitleColorCommand}" CommandParameter="#90EE90" />
<RadioButton x:Name="TitleColor_Orange" x:FieldModifier="public" GroupName="TitleColor" Background="#FFB366" Tag="#FFB366" ToolTip="#FFB366" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectTitleColorCommand}" CommandParameter="#FFB366" />
    </StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
        <TextBlock Text="字号" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="12" Maximum="32" Value="{Binding TitleFontSize, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" Text="{Binding TitleFontSizeText}" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
        <TextBlock Text="不透明度" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
        <Slider x:Name="TitleOpacitySlider" x:FieldModifier="public" Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding TitleOpacity, Mode=TwoWay}" />
        <TextBlock x:Name="TitleOpacityValueText" x:FieldModifier="public" Grid.Column="2" Text="{Binding TitleOpacityText}" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
</StackPanel></Border>
<Border Style="{StaticResource CardBorderStyle}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="歌手" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding SetActiveTargetCommand}" CommandParameter="Artist" Padding="9,4" MinHeight="30" ToolTip="编辑歌手颜色">
            <StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="7" Background="{Binding ArtistBrush}" BorderBrush="#BDC9C1" BorderThickness="1" Margin="0,0,8,0" /><TextBlock Text="{Binding ArtistColor}" FontFamily="Consolas" FontSize="12" /></StackPanel>
        </Button>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,14,0,10">
        <RadioButton x:Name="ArtistColor_Light" x:FieldModifier="public" GroupName="ArtistColor" Background="#EFF3F6" Tag="#EFF3F6" ToolTip="#EFF3F6" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectArtistColorCommand}" CommandParameter="#EFF3F6" />
<RadioButton x:Name="ArtistColor_White" x:FieldModifier="public" GroupName="ArtistColor" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="#FFFFFF" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectArtistColorCommand}" CommandParameter="#FFFFFF" />
<RadioButton x:Name="ArtistColor_Yellow" x:FieldModifier="public" GroupName="ArtistColor" Background="#F0E080" Tag="#F0E080" ToolTip="#F0E080" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectArtistColorCommand}" CommandParameter="#F0E080" />
<RadioButton x:Name="ArtistColor_Green" x:FieldModifier="public" GroupName="ArtistColor" Background="#90EE90" Tag="#90EE90" ToolTip="#90EE90" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectArtistColorCommand}" CommandParameter="#90EE90" />
<RadioButton x:Name="ArtistColor_Orange" x:FieldModifier="public" GroupName="ArtistColor" Background="#FFB366" Tag="#FFB366" ToolTip="#FFB366" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectArtistColorCommand}" CommandParameter="#FFB366" />
    </StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
        <TextBlock Text="字号" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="10" Maximum="24" Value="{Binding ArtistFontSize, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" Text="{Binding ArtistFontSizeText}" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
        <TextBlock Text="不透明度" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
        <Slider x:Name="ArtistOpacitySlider" x:FieldModifier="public" Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding ArtistOpacity, Mode=TwoWay}" />
        <TextBlock x:Name="ArtistOpacityValueText" x:FieldModifier="public" Grid.Column="2" Text="{Binding ArtistOpacityText}" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
</StackPanel></Border>
<Border Style="{StaticResource CardBorderStyle}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="歌词" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding SetActiveTargetCommand}" CommandParameter="Lyrics" Padding="9,4" MinHeight="30" ToolTip="编辑歌词颜色">
            <StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="7" Background="{Binding LyricsBrush}" BorderBrush="#BDC9C1" BorderThickness="1" Margin="0,0,8,0" /><TextBlock Text="{Binding LyricsColor}" FontFamily="Consolas" FontSize="12" /></StackPanel>
        </Button>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,14,0,10">
        <RadioButton x:Name="LyricsColor_Light" x:FieldModifier="public" GroupName="LyricsColor" Background="#A0B8D0" Tag="#A0B8D0" ToolTip="#A0B8D0" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectLyricsColorCommand}" CommandParameter="#A0B8D0" />
<RadioButton x:Name="LyricsColor_White" x:FieldModifier="public" GroupName="LyricsColor" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="#FFFFFF" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectLyricsColorCommand}" CommandParameter="#FFFFFF" />
<RadioButton x:Name="LyricsColor_Yellow" x:FieldModifier="public" GroupName="LyricsColor" Background="#F0E080" Tag="#F0E080" ToolTip="#F0E080" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectLyricsColorCommand}" CommandParameter="#F0E080" />
<RadioButton x:Name="LyricsColor_Green" x:FieldModifier="public" GroupName="LyricsColor" Background="#90EE90" Tag="#90EE90" ToolTip="#90EE90" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectLyricsColorCommand}" CommandParameter="#90EE90" />
<RadioButton x:Name="LyricsColor_Orange" x:FieldModifier="public" GroupName="LyricsColor" Background="#FFB366" Tag="#FFB366" ToolTip="#FFB366" Style="{StaticResource ColorSwatchRadioStyle}" Command="{Binding SelectLyricsColorCommand}" CommandParameter="#FFB366" />
    </StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
        <TextBlock Text="字号" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="9" Maximum="20" Value="{Binding LyricsFontSize, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" Text="{Binding LyricsFontSizeText}" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
        <TextBlock Text="不透明度" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
        <Slider x:Name="LyricsOpacitySlider" x:FieldModifier="public" Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding LyricsOpacity, Mode=TwoWay}" />
        <TextBlock x:Name="LyricsOpacityValueText" x:FieldModifier="public" Grid.Column="2" Text="{Binding LyricsOpacityText}" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
</StackPanel></Border>
                <views:ColorPickerView x:Name="MainColorPicker" Width="Auto" HorizontalAlignment="Stretch"
                                       TitleText="{Binding ActiveColorTargetTitle}" SelectedHexColor="{Binding ActiveColorHex, Mode=TwoWay}" />
            </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="AppearancePreview" Grid.Column="2">
                <TextBlock Text="浮窗预览" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,20" />
                <Border x:Name="PreviewSurface" Height="340" Background="#252830" CornerRadius="20">
                    <Viewbox Margin="16" Stretch="Uniform" StretchDirection="DownOnly">
                    <Border x:Name="ThemePreviewCard" x:FieldModifier="public" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12">
                        <StackPanel>
                            <Image Width="112" Height="112" Source="/HorizonRadioOverlay;component/Assets/Artwork/preview-forest.jpg" Stretch="UniformToFill" HorizontalAlignment="Center">
                                <Image.Clip><RectangleGeometry Rect="0,0,112,112" RadiusX="7" RadiusY="7" /></Image.Clip>
                            </Image>
                            <TextBlock x:Name="ThemePreviewTitle" x:FieldModifier="public" Text="林间" FontSize="{Binding TitleFontSize}"
                                       TextWrapping="NoWrap" TextTrimming="None" HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{Binding TitleBrush}" Opacity="{Binding TitleOpacityRatio}" Margin="0,9,0,0" Effect="{StaticResource OverlayTextShadow}" />
                            <TextBlock x:Name="ThemePreviewArtist" x:FieldModifier="public" Text="Horizon" FontSize="{Binding ArtistFontSize}"
                                       TextWrapping="NoWrap" TextTrimming="None" HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{Binding ArtistBrush}" Opacity="{Binding ArtistOpacityRatio}" Margin="0,3,0,0" Effect="{StaticResource OverlayTextShadow}" />
                            <TextBlock x:Name="ThemePreviewLyrics" x:FieldModifier="public" Text="风经过树梢" FontSize="{Binding LyricsFontSize}"
                                       TextWrapping="NoWrap" TextTrimming="None" HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{Binding LyricsBrush}" Opacity="{Binding LyricsOpacityRatio}" Margin="0,6,0,0" Effect="{StaticResource OverlayTextShadow}" />
                        </StackPanel>
                    </Border>
                    </Viewbox>
                </Border>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="预览背景" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton GroupName="Backdrop" Background="#E8EAEE" Tag="#E8EAEE" Style="{StaticResource ColorSwatchRadioStyle}" Click="PreviewBackdrop_Click" ToolTip="浅色" />
                        <RadioButton GroupName="Backdrop" Background="#9CA3AC" Tag="#9CA3AC" Style="{StaticResource ColorSwatchRadioStyle}" Click="PreviewBackdrop_Click" ToolTip="中性" />
                        <RadioButton GroupName="Backdrop" Background="#252830" Tag="#252830" IsChecked="True" Style="{StaticResource ColorSwatchRadioStyle}" Click="PreviewBackdrop_Click" ToolTip="深色" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
</UserControl>
