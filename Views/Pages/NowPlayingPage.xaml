<UserControl x:Class="HorizonRadioOverlay.Views.Pages.NowPlayingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent"
             SizeChanged="NowPlayingPage_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,10,32,30">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CoverColumn" Width="400" /><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
                <Grid x:Name="ArtworkStage" Width="400" Height="400">
                    <Grid x:Name="RecordDisc" Width="350" Height="350" HorizontalAlignment="Right" Margin="0,20,-28,20" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                        <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPlaying}" Value="True" />
                                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions><BeginStoryboard x:Name="RecordRotation"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:24" RepeatBehavior="Forever" />
                                </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="RecordRotation" /></MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </Style.Triggers></Style></Grid.Style>
                        <Ellipse Fill="#282B32" />
                        <Ellipse Margin="12" Stroke="#3F4249" StrokeThickness="1" />
                        <Ellipse Margin="20" Stroke="#3F4249" StrokeThickness="1" />
                        <Ellipse Margin="28" Stroke="#3F4249" StrokeThickness="1" />
                        <Ellipse Margin="36" Stroke="#3F4249" StrokeThickness="1" />
                        <Ellipse Margin="130" Fill="{DynamicResource PrimaryBrush}" />
                        <Rectangle Width="3" Height="30" Fill="#767B85" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" />
                    </Grid>
                <Border x:Name="AlbumSurface" Width="400" Height="400" CornerRadius="28" Background="{DynamicResource TextBrush}" ClipToBounds="True">
                    <Border.Effect><DropShadowEffect Color="#252B3C" BlurRadius="20" ShadowDepth="10" Direction="270" Opacity="0.18" /></Border.Effect>
                    <Grid>
                        <TextBlock Text="h." FontFamily="Bahnschrift" FontSize="180" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="HORIZON" FontFamily="Bahnschrift" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Bottom" Margin="24" />
                        <Image x:Name="CoverPreview" x:FieldModifier="public" Source="{Binding CoverImage}" Stretch="UniformToFill">
                            <Image.Clip><RectangleGeometry x:Name="AlbumClip" Rect="0,0,400,400" RadiusX="28" RadiusY="28" /></Image.Clip>
                        </Image>
                    </Grid>
                </Border>
                </Grid>
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" x:FieldModifier="public" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="刷新同步">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}" FontSize="14" />
                    </Button>
                </Grid>
            </StackPanel>
            <Grid x:Name="NowPlayingInfoPanel" Grid.Column="2" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="3" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="NOW PLAYING" FontFamily="Bahnschrift" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" />
                </StackPanel>
                <Viewbox Grid.Row="1" Height="72" Width="{Binding ActualWidth, ElementName=NowPlayingInfoPanel}" Margin="0,20,0,0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock x:Name="CurrentTitle" x:FieldModifier="public" Text="{Binding Title}" FontSize="46" FontWeight="SemiBold"
                               HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="NoWrap" TextTrimming="None" />
                </Viewbox>
                <Viewbox Grid.Row="2" Height="28" Width="{Binding ActualWidth, ElementName=NowPlayingInfoPanel}" Margin="0,5,0,0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock x:Name="CurrentArtist" x:FieldModifier="public" Text="{Binding Artist}" FontSize="17" Foreground="{DynamicResource SubtleTextBrush}"
                               HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="NoWrap" TextTrimming="None" />
                </Viewbox>
                <TextBlock x:Name="CurrentMeta" x:FieldModifier="public" Grid.Row="3" Text="{Binding SourceText}" FontSize="12" Foreground="{DynamicResource FaintTextBrush}"
                           Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="4" Margin="0,22,0,18">
                    <TextBlock x:Name="PreviousLyricLine" Text="{Binding PreviousLyric}" FontSize="14" Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" MinHeight="22" />
                    <Viewbox Height="65" Width="{Binding ActualWidth, ElementName=NowPlayingInfoPanel}" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock x:Name="LyricsPreviewText" x:FieldModifier="public" Text="{Binding LyricsPreview}" FontSize="24"
                                   TextWrapping="NoWrap" TextTrimming="None" HorizontalAlignment="Center" TextAlignment="Center" />
                    </Viewbox>
                </StackPanel>
                <Grid x:Name="ElapsedPanel" Grid.Row="5" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ElapsedText}" FontFamily="Bahnschrift" FontSize="54" FontWeight="Light" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="14,0,0,10">
                        <TextBlock Text="ELAPSED / TOTAL" FontFamily="Bahnschrift" FontSize="11" Foreground="{DynamicResource FaintTextBrush}" />
                        <TextBlock Text="{Binding DurationText}" FontFamily="Consolas" FontSize="13" Margin="0,5,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ConnectionStatusText" x:FieldModifier="public" Text="{Binding ConnectionStatus}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock x:Name="ConnectionStatusSubText" x:FieldModifier="public" Text="{Binding ConnectionStatusDetail}" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="OpenFloatingSettingsButton" x:FieldModifier="public" Style="{StaticResource IconButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="FloatingSettings" ToolTip="浮窗设置">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource IconTextStyle}" />
                        </Button>
                        <Button x:Name="OpenHotkeySettingsButton" x:FieldModifier="public" Style="{StaticResource IconButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Hotkeys" ToolTip="快捷键">
                            <TextBlock Text="&#xE765;" Style="{StaticResource IconTextStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
