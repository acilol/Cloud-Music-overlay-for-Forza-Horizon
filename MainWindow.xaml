<Window x:Class="HorizonRadioOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HorizonRadioOverlay"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Horizon · 音乐浮窗" MinHeight="620" MinWidth="920" Width="1280" Height="850"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="16" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="128" /></Grid.RowDefinitions>
            <Border Grid.RowSpan="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="78" /><RowDefinition Height="*" /><RowDefinition Height="78" /></Grid.RowDefinitions>
                    <Border x:Name="SidebarIconBadge" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource TextBrush}" VerticalAlignment="Center">
                        <TextBlock Text="h." FontFamily="Bahnschrift" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ListBox x:Name="NavigationListBox" Grid.Row="1" ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionChanged="NavigationListBox_SelectionChanged"
                             Background="Transparent" BorderThickness="0" Padding="7,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Root" Background="Transparent" CornerRadius="14" Padding="0,8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource MutedSurfaceBrush}" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,7,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Click="GitHubButton_Click" ToolTip="我们的 GitHub 仓库">
                            <Image x:Name="GitHubImage" Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                        <TextBlock FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0">
                            <Hyperlink ToolTip="BiliBili:EosphorosVeil" TextDecorations="{x:Null}" Foreground="{DynamicResource FaintTextBrush}"
                                       NavigateUri="https://space.bilibili.com/3546867382094629" RequestNavigate="BilibiliLink_RequestNavigate">Bilibili</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="144" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="HORIZON" FontFamily="Bahnschrift" FontSize="22" />
                    <TextBlock Text="音乐浮窗" FontSize="12" Foreground="{DynamicResource FaintTextBrush}" Margin="14,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,22,0">
                    <TextBlock x:Name="SidebarConnectionStateText" Text="等待播放器" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" />
                    <TextBlock x:Name="SidebarConnectionSubText" Text="网易云音乐" FontSize="12" Foreground="{DynamicResource FaintTextBrush}" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButtonStyle}" Width="46" Height="56" Click="MinimizeWindow_Click" ToolTip="最小化"><TextBlock Text="&#xE921;" Style="{StaticResource IconTextStyle}" FontSize="12" /></Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="46" Height="56" Click="MaximizeWindow_Click" ToolTip="最大化 / 还原"><TextBlock x:Name="ChromeMaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconTextStyle}" FontSize="12" /></Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="46" Height="56" Click="CloseWindow_Click" ToolTip="关闭"><TextBlock Text="&#xE8BB;" Style="{StaticResource IconTextStyle}" FontSize="12" /></Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ResetSettingsButton" Style="{StaticResource IconButtonStyle}" Click="ResetOverlaySettings_Click" ToolTip="恢复默认设置" Margin="0,0,10,0"
                                Visibility="{Binding ShowSettingsActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="&#xE777;" Style="{StaticResource IconTextStyle}" />
                        </Button>
                        <Button x:Name="TestOverlayButton" Click="TestOverlay_Click" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0"
                                Visibility="{Binding ShowOverlayPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource IconTextStyle}" Margin="0,0,8,0" /><TextBlock Text="预览浮窗" /></StackPanel>
                        </Button>
                        <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButtonStyle}" Click="SaveOverlaySettings_Click"
                                Visibility="{Binding ShowSettingsActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource IconTextStyle}" Margin="0,0,8,0" /><TextBlock Text="保存" Foreground="{DynamicResource AccentTextBrush}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <ContentControl x:Name="PageHost" Grid.Row="1" />
            </Grid>
            <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="22" Margin="22,6,22,18">
                <Border.Resources>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2128" />
                    <SolidColorBrush x:Key="TextBrush" Color="#F7F8FB" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A5ABB7" />
                    <SolidColorBrush x:Key="FaintTextBrush" Color="#8E96A7" />
                    <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#383D47" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#1E2128" />
                </Border.Resources>
                <Grid Margin="24,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid x:Name="MiniPlayerPanel" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource MutedSurfaceBrush}" ClipToBounds="True">
                            <Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /><Image Source="{Binding CoverImage}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,46,46" RadiusX="12" RadiusY="12" /></Image.Clip></Image></Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,18,0">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding DataContext, ElementName=MiniPlayerPanel}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,9">
                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding PrevCommand}" ToolTip="上一首" Margin="0,0,20,0"><TextBlock Text="&#xE892;" Style="{StaticResource IconTextStyle}" /></Button>
                            <Button Style="{StaticResource PlayButtonStyle}" Width="50" Height="50" Command="{Binding PlayPauseCommand}" ToolTip="播放或暂停"><TextBlock Text="{Binding PlaybackGlyph}" Style="{StaticResource IconTextStyle}" Foreground="{DynamicResource AccentTextBrush}" FontSize="20" /></Button>
                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding NextCommand}" ToolTip="下一首" Margin="20,0,0,0"><TextBlock Text="&#xE893;" Style="{StaticResource IconTextStyle}" /></Button>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Height="3" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource MutedSurfaceBrush}" BorderThickness="0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.ToggleOverlayCommand, ElementName=MiniPlayerPanel}" ToolTip="显示 / 隐藏浮窗" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource IconTextStyle}" />
                        </Button>
                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" MaxWidth="180" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FaintTextBrush}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <TextBlock x:Name="FooterSourceText" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
